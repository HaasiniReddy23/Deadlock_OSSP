
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    pid_t pid;
    int status;

    pid = fork();

    if (pid < 0) {
        perror("Fork failed");
        exit(1);
    }
    else if (pid == 0) {
        printf("Child process executing ls command\n");

        execlp("ls", "ls", "-la", (char *)NULL);

        perror("Exec failed");
        exit(1);
    }
    else {
        printf("Parent waiting for child...\n");

        wait(&status);

        if (WIFEXITED(status)) {
            printf("Child exited with status: %d\n",
                   WEXITSTATUS(status));
        }

        printf("Parent process completed\n");
    }

    return 0;
}
